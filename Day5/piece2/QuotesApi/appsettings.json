{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=quotes.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "OpenTelemetry": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "https://yourapp.com",
    "Audience": "quotes-api",
    "AccessTokenLifetime": "00:15:00"
  },
  "Pagination": {
    "MaxPageSize": 100
  },
  "AzureAd": {
    "Authority": "https://login.microsoftonline.com/f774bb68-0575-4cd2-9d4c-3b4e593d1110/v2.0",
    "ClientId": "91566dbd-d857-488a-858d-475e60b309b7",
